#!/bin/bash
# site-vendor — download an explicit list of files from a game's official
# site into a payload dir, preserving paths. Used by fetch-at-install casks:
# the tap redistributes NOTHING of the game; the installing machine fetches
# it from the source at install time (like brew fetching from upstream).
#
# Usage:
#   site-vendor --base-url https://example.com --out DIR \
#               --path a/b.js [--path ...] [--optional c/d.ini ...]
#
#   --path      Required file (site-relative). Any failure aborts loudly.
#   --optional  Best-effort file: a 404 is skipped (some games probe for
#               files their own server no longer has).
#
# Every download is bounded (--connect-timeout 5, --max-time 120, 2 retries)
# and lands atomically (tmp file + mv). Exits nonzero with the offending URL
# on any required failure — cask preflights surface that as "install needs
# network once".
set -euo pipefail

log() { printf 'site-vendor: %s\n' "$*" >&2; }
die() { log "ERROR: $*"; exit 1; }

base_url="" out=""
required=() optional=()
while [ $# -gt 0 ]; do
  case "$1" in
    --base-url) base_url=${2:?--base-url needs a value}; shift 2 ;;
    --out)      out=${2:?--out needs a value}; shift 2 ;;
    --path)     required+=("${2:?--path needs a value}"); shift 2 ;;
    --optional) optional+=("${2:?--optional needs a value}"); shift 2 ;;
    -h|--help)  awk 'NR==1{next} !/^#/{exit} {sub(/^# ?/,""); print}' "$0"; exit 0 ;;
    *)          die "unknown argument: $1" ;;
  esac
done
[ -n "$base_url" ] || die "--base-url is required"
[ -n "$out" ]      || die "--out is required"
[ ${#required[@]} -gt 0 ] || die "at least one --path is required"
base_url=${base_url%/}

fetch() { # $1=relpath  $2=required|optional
  local rel="$1" kind="$2" url dest tmp code
  case "$rel" in
    /*|*..*) die "unsafe path (absolute or ..): $rel" ;;
  esac
  url="$base_url/$rel"
  dest="$out/$rel"
  mkdir -p "$(dirname "$dest")"
  tmp="$dest.part"
  code=$(curl -sL --connect-timeout 5 --max-time 120 --retry 2 \
              -o "$tmp" -w '%{http_code}' "$url") || code=000
  if [ "$code" != "200" ]; then
    rm -f "$tmp"
    if [ "$kind" = "optional" ]; then
      log "optional file unavailable, skipping | url='$url' http_code='$code'"
      return 0
    fi
    die "download failed | url='$url' http_code='$code' hint='installing this game needs network access once'"
  fi
  [ -s "$tmp" ] || { rm -f "$tmp"; die "empty download | url='$url'"; }
  mv "$tmp" "$dest"
  log "fetched $rel ($(wc -c < "$dest" | tr -d ' ') bytes)"
}

for p in "${required[@]}"; do fetch "$p" required; done
if [ ${#optional[@]} -gt 0 ]; then
  for p in "${optional[@]}"; do fetch "$p" optional; done
fi
log "OK: ${#required[@]} required file(s) into $out"
